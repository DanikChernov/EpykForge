# EPYK Forge local configuration
FORGE_ENV=local
FORGE_DEMO_MODE=true
FORGE_DEMO_DATA_ENABLED=true
FORGE_DEMO_SPEED=8
FORGE_STORE_BACKEND=local
FORGE_STATE_PATH=./data/forge_state.json
FORGE_EVENT_BUS=inprocess

# Use TEST_STUB for local tests and smoke demos.
# Use REAL_GEMINI for the hackathon demo and production deployment.
FORGE_MODEL_PROVIDER=TEST_STUB
FORGE_GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_ENTERPRISE=True
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Demo auth is intentionally simple and synthetic.
FORGE_DEMO_SUPERVISOR_TOKEN=demo-supervisor-token
FORGE_ADMIN_PIN=1234

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_DEMO_SUPERVISOR_TOKEN=demo-supervisor-token
