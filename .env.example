# EPYK Forge local and deployment configuration
FORGE_ENV=local
FORGE_STORE_BACKEND=local
FORGE_STATE_PATH=./data/forge_state.json
FORGE_EVENT_BUS=inprocess

# Use TEST_STUB for local tests. Use REAL_GEMINI only with Google Cloud auth configured.
FORGE_MODEL_PROVIDER=TEST_STUB
FORGE_GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_ENTERPRISE=True

# Google Cloud deployment scripts
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Deployed forge-web origin allowed by forge-api CORS. The deploy script sets this automatically.
FORGE_WEB_ORIGIN=

# Frontend build-time API target. Local Vite dev defaults to http://localhost:8080 when this is blank.
VITE_FORGE_API_URL=
